# 웹 에이전트 서비스 (모바일에서 Claude Code 대화) — 8008 백엔드와 별개.
# 8008 백엔드는 여전히 on-demand(systemd 금지)이고, 이 유닛은 에이전트만 띄운다.
# backend/.env에 AGENT_ENABLED=true, AGENT_OWNER_EMAIL=<본인 이메일>이 있어야 동작 (기본 꺼짐).
#
# 바인드: 0.0.0.0이면 LAN + Tailscale 양쪽에서 열린다. /etc/systemd/system에 복사한 쪽에서
# --host를 `tailscale ip -4` 값으로 바꿔 Tailscale 전용으로 쓸 것 (실 IP는 공개 레포에 커밋 금지).
[Unit]
Description=exam-app Web Agent (Claude Agent SDK)
After=network-online.target tailscaled.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
User=fireworms
WorkingDirectory=/home/fireworms/exam-app/backend
# 터미널과 같은 claude CLI(같은 버전·구독 로그인)를 찾도록 ~/.local/bin을 PATH에 둔다
Environment=PATH=/home/fireworms/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/fireworms/exam-app/backend/venv/bin/uvicorn agent_main:app --host 0.0.0.0 --port 8009
# Tailscale보다 먼저 뜨면 bind 실패 → 재시도 (5분에 10회 제한 — [Unit] StartLimit*)
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
